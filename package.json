{
  "name": "reelmap",
  "version": "1.0.0",
  "private": true,
  "description": "Find which countries and streaming services carry any movie or show.",
  "license": "MIT",
  "author": "Nishant Kumar",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs",
    "build:embedded": "node scripts/build.mjs && node scripts/build-embedded.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/lint.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
